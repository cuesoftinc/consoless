    {
      "id": "flow-edit",
      "type": "sequence",
      "title": "Code edit to new version",
      "caption": "<strong>A hand edit gets the same check as a generated one.</strong> The Studio saves changed files; <code>api/common</code> sends them straight to <code>api/verify</code>, skipping the model. A passing edit becomes a version; a failing one returns its errors and keeps the user's text.",
      "sequence": {
        "aria": "Sequence for a user code edit: the Studio sends changed files to api/common, which stores them and queues check.requested; api/verify runs the check and reports check.completed; api/common records a new version or returns the report while the Studio polls.",
        "lanes": [
          {
            "id": "s",
            "title": "Studio",
            "sub": "code view",
            "kind": "client"
          },
