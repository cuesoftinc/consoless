    {
      "id": "rules",
      "type": "rules",
      "title": "The rules",
      "items": [
        {
          "title": "Go only does CRUD.",
          "text": "<code>api/common</code> is the only service that opens Postgres, Redis, <code>blobs/</code> or the play bucket. It saves decisions; it never makes them."
        },
        {
          "title": "Python makes every decision.",
          "text": "Prompt policy, generation, moderation and the pass-or-fail verdict all happen in <code>api/generate</code> and <code>api/verify</code>."
        },
        {
          "title": "Generated code never runs on our origin.",
          "text": "Games load only from the play origin in a sandboxed iframe. The runtime never calls the API; scores travel by <code>postMessage</code>."
        },
        {
          "title": "Pointers, not data.",
          "text": "Prompts, code and reports live under <code>consoless/compute/</code>. Bus messages carry only ids, enums and refs."
        }
      ]
    },
