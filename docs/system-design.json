            "from": "s",
            "to": "c",
            "text": "PUT /projects/{id}/files"
          },
          {
            "from": "c",
            "to": "b",
            "kind": "storage-write",
            "text": "put compute/candidate"
          },
          {
            "from": "c",
            "to": "s",
            "kind": "reply",
            "text": "202 · checking"
          },
          {
            "from": "c",
            "to": "k",
            "kind": "kafka",
            "text": "check.requested"
          },
          {
            "from": "k",
            "to": "v",
            "kind": "kafka",
            "text": "check.requested"
          },
          {
            "from": "v",
            "to": "b",
