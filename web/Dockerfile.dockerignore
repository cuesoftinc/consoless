# BuildKit per-Dockerfile ignore for the web image (repo-root context:
# docker-compose `context: .` + `dockerfile: web/Dockerfile`). Only web/
# ships into the context.
*
!web

web/node_modules
web/.next
web/out
web/test-results
web/playwright-report
web/.env
web/.env.*
!web/.env.example
web/npm-debug.log*
web/.DS_Store
